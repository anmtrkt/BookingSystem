		string reason)
		{
		RoomId = roomId;
		StartDate = startDate;
		EndDate = endDate;
		Reason = reason;
		}
		/// <exception cref="ArgumentException"></exception>
		public static Schedule Create(
		Guid roomId,
		DateTime startDate,
		DateTime endDate,
