	<file path="BoolingSystem — копия/BookingSystem.Infrastructure/Persistence/UnitOfWork.cs">
		using BookingSystem.Core.Domain.Common.Interfaces;
		using Microsoft.EntityFrameworkCore.Storage;
		using System;
		using System.Collections.Generic;
		using System.Linq;
		using System.Text;
		using System.Threading.Tasks;
		namespace BookingSystem.Infrastructure.Persistence
		{
		public class UnitOfWork: IUnitOfWork
		{
		private readonly BookingSystemDbContext _context;
		private IDbContextTransaction _transaction;
		public UnitOfWork(BookingSystemDbContext context)
		{
		_context = context;
		}
		public async Task<int> CommitAsync(CancellationToken cancellationToken = default)
        {
            if (_transaction == null)
                throw new InvalidOperationException("Transaction not started");
            try
            {
                int result = await _context.SaveChangesAsync(cancellationToken);
                await _transaction.CommitAsync(cancellationToken);
                return result;
            }
            catch
            {
                await _transaction.RollbackAsync(cancellationToken);
                throw;
            }
            finally
            {
                _transaction.Dispose();
                _transaction = null;
            }
        }
        public void BeginTransaction()
        {
            if (_transaction != null)
                throw new InvalidOperationException("Transaction already started");
            _transaction = _context.Database.BeginTransaction();
        }
        public void Rollback()
        {
            if (_transaction == null)
                throw new InvalidOperationException("No active transaction");
            _transaction.Rollback();
            _transaction.Dispose();
            _transaction = null;
        }
    }
}
</file>

	<file path="BoolingSystem — копия/BookingSystem.Infrastructure/Services/BookingService.cs">
		using BookingSystem.Core.Domain.Entities;
		using BookingSystem.Core.Domain.Repositories;
		using BookingSystem.Core.Domain.ValueObjects;
		using BookingSystem.Core.Domain.Events;
		using System.Threading.Tasks;
		using BookingSystem.Core.Domain.Common.Interfaces;
		namespace BookingSystem.Infrastructure.Services
		{
		public class BookingService
		{
		private readonly IRoomRepository _roomRepo;
		private readonly IMeetingRepository _meetingRepo;
		private readonly IInstitutionRepository _institutionRepo;
		private readonly IUnitOfWork _unitOfWork;
		public BookingService(
		IRoomRepository roomRepo,
		IMeetingRepository meetingRepo,
		IInstitutionRepository institutionRepo)
		{
		_roomRepo = roomRepo;
		_meetingRepo = meetingRepo;
		_institutionRepo = institutionRepo;
		}
		public async Task<Guid>
			BookRoom(DateTime startTime, DateTime endTime, Room room, User user, List<User>? subscribers = null)
        {
            if (!room.CanBeBooked(TimeRange.Create(startTime, endTime), user.Priority))
                throw new ApplicationException("Room is not available");
            _unitOfWork.BeginTransaction();
            try
            {
                var meeting = Meeting.Create(
                user,
                room,
                startTime,
                endTime,
                user.Institution,
                subscribers ??= new());
                await _meetingRepo.AddAsync(meeting);
                await _unitOfWork.CommitAsync();
                return meeting.Id;
            }
            catch
            {
                _unitOfWork.Rollback();
                throw;
            }
        }
    }
}
</file>

	<file path="BoolingSystem — копия/BookingSystem.Infrastructure/Services/OutboxProcessor.cs">
		using BookingSystem.Core.Domain.Events;
		using BookingSystem.Infrastructure.Persistence;
		using Hangfire;
		using MediatR;
		using System;
		using System.Collections.Generic;
		using System.Linq;
		using System.Text;
		using System.Text.Json;
		using System.Threading.Tasks;
		namespace BookingSystem.Infrastructure.Services
		{
		public class OutboxProcessor
		{
		private readonly BookingSystemDbContext _context;
		private readonly IPublisher _publisher;
		public OutboxProcessor(BookingSystemDbContext context, IPublisher publisher)
		{
		_context = context;
		_publisher = publisher;
		}
		[AutomaticRetry(Attempts = 3)]
		public async Task ProcessOutboxMessages()
		{
		var messages = await _context
		.OutboxMessages
		.Where(m => m.ProcessedAt == null)
		.OrderBy(m => m.CreatedAt)
		.Take(100)
		.ToListAsync();
		foreach (var message in messages)
		{
		var eventType = Type.GetType(message.EventType);
		var eventData = JsonSerializer.Deserialize(message.Payload, eventType) as IDomainEvent;
		await _publisher.Publish(eventData);
		message.ProcessedAt = DateTime.UtcNow;
		}
		await _context.SaveChangesAsync();
		}
		}
		}
	</file>

