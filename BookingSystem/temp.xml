	<file path="BoolingSystem — копия/BookingSystem.API/Controllers/BookingController.cs">
		// File: BookingSystem.API/Controllers/BookingController.cs
		using BookingSystem.Core.Domain.Entities;
		using BookingSystem.Infrastructure.Services;
		using Microsoft.AspNetCore.Authorization;
		using Microsoft.AspNetCore.Mvc;
		[ApiController]
		[Route("api/[controller]")]
		public class BookingController : ControllerBase
		{
		private readonly BookingService _bookingService;
		[HttpPost]
		[Authorize(Roles = "User,Admin")]
		public async Task<IActionResult>
			BookRoom([FromBody] BookRoomRequest request)
			{
			var result = await _bookingService.BookRoom(
			request.StartTime,
			request.EndTime,
			request.RoomId,
			User.GetUserId()
			);
			return Ok(result);
			}
			[HttpDelete("{id}")]
			[Authorize(Roles = "User,Admin")]
			public async Task<IActionResult> CancelBooking(Guid id)
    {
        await _bookingService.CancelBookingAsync(id, User.GetUserId());
        return NoContent();
    }
}
</file>

