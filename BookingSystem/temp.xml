	<file path="BoolingSystem — копия/BookingSystem.Infrastructure/EventHandlers/BookingCreatedEventHandler.cs">
		using MediatR;
		using BookingSystem.Core.Domain.Events;
		using BookingSystem.Core.Domain.Repositories;
		using BookingSystem.Core.Domain.Entities;
		using System.Threading;
		using System.Threading.Tasks;
		namespace BookingSystem.Application.EventHandlers
		{
		public class BookingCreatedEventHandler : INotificationHandler<BookingCreatedEvent>
			{
			private readonly INotificationRepository _notificationRepository;
			private readonly IMeetingRepository _meetingRepository;
			public BookingCreatedEventHandler(INotificationRepository notificationRepository, IMeetingRepository meetingRepository )
			{
			_notificationRepository = notificationRepository;
			_meetingRepository = meetingRepository;
			}
			public async Task Handle(BookingCreatedEvent notification, CancellationToken cancellationToken)
			{
			var meeting = await _meetingRepository.GetByIdAsync(notification.MeetingId);
			var creator = meeting.Creator;
			for(int i = 0; i < meeting.Subscribers.Count; i++) 
            {
                var notificationMessage = $"Уважаемый {meeting.Subscribers[i].Name} {meeting.Subscribers[i].Surname}! {creator.FullName} назначил встречу {meeting.StartTime}, в {meeting.Room}";
                var notificationEntity = Notification.Create(
                    meeting.Subscribers[i].Id,
                    "Meeting Booking",
                    notificationMessage
                );
                await _notificationRepository.AddAsync(notificationEntity);
            }
        }
    }
}
	</file>

